#include <dt-bindings/zmk/input_transform.h>

/ {
    /* 
     * input_processors ノード内に定義することで、
     * システム側の Binding (zmk,input-processor-if-layer) と紐付けます。
     */
    input_processors {
        ib_scroll_report: ib_scroll_report {
            compatible = "zmk,input-processor-if-layer";
            #input-processor-cells = <2>;
            bindings = <&scroller>;
        };
    };

    behaviors {
        // スクロール挙動
        scroller: scroller {
            compatible = "zmk,behavior-input-two-axis-scroll";
            #binding-cells = <0>;
            trigger-period-ms = <12>;
            type = "wheel";
            scale = <16>;
        };

        // Mod-Tap 上書き
        mod_tap: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Layer-Tap 上書き
        layer_tap: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };
};

/*
 * 【決定版：ラベル未定義回避策】
 * センサーのドライバ基盤である「SPIバス上のポインティングデバイス」を
 * ワイルドカード的に検索してCPI設定（400）を強制インジェクションします。
 * これにより、スニペットの有無や左右のビルド環境に依存せずエラーを完全に回避します。
 */
&spi0 {
    status = "okay";
    trackball: trackball@0 {
        cpi = <400>;
    };
};
