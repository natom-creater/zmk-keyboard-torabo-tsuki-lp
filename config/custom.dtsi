#include <dt-bindings/zmk/input_transform.h>

/ {
    /* 
     * input_processors ノード内に定義することで、
     * システム側の Binding (zmk,input-processor-if-layer) と紐付けます。
     */
    input_processors {
        ib_scroll_report: ib_scroll_report {
            compatible = "zmk,input-processor-if-layer";
            #input-processor-cells = <2>;
            bindings = <&scroller>;
        };
    };

    behaviors {
        // スクロール挙動
        scroller: scroller {
            compatible = "zmk,behavior-input-two-axis-scroll";
            #binding-cells = <0>;
            trigger-period-ms = <12>;
            type = "wheel";
            scale = <16>;
        };

        // Mod-Tap 上書き
        mod_tap: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Layer-Tap 上書き
        layer_tap: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };
};

/* 
 * トラックボールのハードウェア解像度（CPI）を上書き
 * 初期設定のままだと高感度すぎてタイピングの微振動を拾うため、
 * 400（または600程度）に落として誤反応を抑制します。
 */
&trackball {
    /delete-property/ cpi;
    cpi = <400>;
};
