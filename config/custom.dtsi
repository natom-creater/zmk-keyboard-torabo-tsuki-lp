#include <dt-bindings/zmk/input_transform.h>

/ {
    behaviors {
        // スクロール速度などの設定
        scroller: scroller {
            compatible = "zmk,behavior-input-two-axis-scroll";
            #binding-cells = <0>;
            trigger-period-ms = <12>;
            type = "wheel";
            // scaleを16程度に設定（overlayのscroll-speed 100相当にするには調整が必要かもしれません）
            scale = <16>; 
        };

        // レイヤー6の判定プロセッサ
        ib_scroll_report: ib_scroll_report {
            compatible = "zmk,input-behavior-if-layer";
            #binding-cells = <2>;
            bindings = <&scroller>;
        };
    };
};
