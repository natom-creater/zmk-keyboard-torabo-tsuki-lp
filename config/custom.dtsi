/ {
    behaviors {
        // 標準の &mt (Mod-Tap) を 400ms に設定
        mod_tap: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // 標準の &lt (Layer-Tap) を 400ms に設定
        layer_tap: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        // スクロール用 Behavior
        scroller: scroller {
            compatible = "zmk,behavior-input-two-axis-scroll";
            #binding-cells = <0>;
            trigger-period-ms = <12>;
            type = "wheel";
            scale = <16>;
        };
    };

    /* 
     * ラベルや絶対パスを使わず、既存ノードを「拡張」する形式に変更 
     * input_listener ノードが後で定義されても、ここでの設定がマージされます
     */
    input_listener: input_listener {
        // 除外キーの設定
        exclude-key-positions = <10 17 18 19 20 21 29 30 31 32 35 37 38 39 40 41 42>;
        
        // レイヤー6ならスクロール、それ以外は通常移動
        input-processors = <&ib_if_layer 6 &scroller>;
    };
};
