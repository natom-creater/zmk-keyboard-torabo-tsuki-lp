#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // --- 追加：ホールド判定の設定 ---
    behaviors {
        &mt {
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;     // quick-tapを無効化
        };
        &lt {
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;     // quick-tapを無効化
        };
    };
    // ----------------------------

    combos {
        compatible = "zmk,combos";

        underbar {
            bindings = <&kp LS(A)>;
            key-positions = <49 50>;
        };
    };

    macros {
        win_shift_s: win_shift_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>;
            label = "WIN_SHIFT_S";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans  &trans             &trans    &trans    &trans                 &trans                                         &trans        &trans  &trans     &trans         &trans                &trans
&trans  &mt ESC Q          &kp W     &kp E     &kp R                  &kp T                                          &kp Y         &kp U   &kp I      &kp O          &lt 0 P               &trans
&trans  &kp A              &kp S     &kp D     &kp F                  &kp G        &trans        &trans              &kp H         &kp J   &kp K      &kp L          &lt 5 MINUS           &trans
&trans  &mt LEFT_SHIFT Z   &kp X     &kp C     &kp V                  &kp B        &lt 5 TAB     &kp B               &kp N         &kp M   &kp COMMA  &kp DOT        &mt RIGHT_SHIFT FSLH  &trans
&trans  &kp LCTRL          &kp LGUI  &kp LALT  &lt 4 INTERNATIONAL_5  &lt 2 SPACE  &lt 3 GRAVE   &kp BACKSPACE       &lt 1 ENTER   &trans  &trans     &lt 2 ESCAPE   &kp RIGHT_CONTROL     &trans
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans             &trans            &trans            &trans            &trans                  &trans  &trans                 &trans             &trans                   &trans  &trans
&trans  &kp LS(N9)         &trans            &trans            &trans            &trans                  &trans  &kp RIGHT_BRACKET      &kp BACKSLASH      &trans                   &trans  &trans
&trans  &kp LS(N5)         &kp LS(NUMBER_6)  &kp LS(N7)        &kp LS(N8)        &trans  &trans  &trans  &trans  &kp LS(N8)             &kp LS(N9)         &kp RS(INTERNATIONAL_1)  &trans  &trans
&trans  &kp LS(NUMBER_1)   &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &trans  &trans  &trans  &trans  &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)  &kp LS(INTERNATIONAL_4)  &trans  &trans
&trans  &trans             &trans            &trans            &trans            &trans  &trans  &trans  &trans  &trans                 &trans             &trans                   &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                  &trans           &trans  &trans  &trans     &trans           &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans                  &kp SLASH        &kp N7  &kp N8  &kp N9     &kp PLUS         &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans  &trans  &kp KP_MULTIPLY  &kp N4  &kp N5  &kp N6     &kp MINUS        &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans  &trans  &kp N0           &kp N1  &kp N2  &kp N3     &kp LS(MINUS)    &trans
&trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &kp DOT          &trans  &trans  &kp ENTER  &kp KP_MULTIPLY  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans             &trans                   &trans             &trans                   &trans                                   &trans    &trans       &trans    &trans         &trans         &trans
&trans  &kp LC(MINUS)      &kp LG(LC(LEFT_ARROW))   &kp LG(UP_ARROW)   &kp LC(LG(RIGHT_ARROW))  &kp LC(LG(F4))                           &kp HOME  &kp PAGE_UP  &kp UP    &kp PAGE_DOWN  &kp BACKSPACE  &trans
&trans  &kp LC(SEMICOLON)  &kp LG(LEFT)             &kp LG(DOWN)       &kp LG(RIGHT)            &kp LC(LG(D))   &trans  &trans           &kp END   &kp LEFT     &kp DOWN  &kp RIGHT      &kp DELETE     &trans
&trans  &trans             &trans                   &trans             &trans                   &kp LG(TAB)     &trans  &kp LG(LS(S))    &trans    &trans       &trans    &trans         &trans         &trans
&trans  &trans             &trans                   &trans             &trans                   &trans          &trans  &kp DEL          &trans    &trans       &trans    &trans         &trans         &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL   &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans   &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans   &mkp MB4  &mo 6     &mkp MB5  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans    &trans    &trans    &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
