#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "custom.dtsi"  // ここを "" に変更

/ {
    // 1. behaviors ブロック：ここがエラーの主な原因になりやすい場所です

    behaviors {
        // &mt (Mod-Tap) の挙動変更
        // &lt (Layer-Tap) の挙動変更
    };

    // 2. combos ブロック

    combos {
        compatible = "zmk,combos";

        underbar {
            bindings = <&kp LS(INTERNATIONAL_1)>;
            key-positions = <49 50>;
        };

        power_sign {
            bindings = <&kp DELETE>;
            key-positions = <22 21>;
        };
    };

    // 3. macros ブロック

    macros {
        BT0_layer0: BT0_layer0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&macro_wait_time 200>, <&to 0>;

            label = "BT0_LAYER0";
        };

        BT4_layer2: BT4_layer2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&macro_wait_time 200>, <&to 2>;

            label = "BT4_LAYER2";
        };

        BT3_layer2: BT3_layer2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&macro_wait_time 200>, <&to 2>;

            label = "BT3_LAYER2";
        };
    };

    // 4. keymap ブロック

    keymap {
        compatible = "zmk,keymap";

        Win_base {
            bindings = <
&trans  &trans            &trans      &trans            &trans                  &trans                                                &trans       &trans  &trans     &trans        &trans                &trans
&trans  &mt ESC Q         &mt C_PP W  &mt LA(C_MUTE) E  &mt C_VOL_DN R          &mt C_VOL_UP T                                        &kp Y        &kp U   &kp I      &kp O         &mt LEFT_BRACKET P    &trans
&trans  &kp A             &kp S       &kp D             &mt C_BRIGHTNESS_DEC F  &mt C_BRIGHTNESS_INC G  &trans       &trans           &kp H        &kp J   &kp K      &kp L         &lt 5 MINUS           &trans
&trans  &mt LEFT_SHIFT Z  &kp X       &kp C             &kp V                   &kp B                   &kp TAB      &kp B            &kp N        &kp M   &kp COMMA  &kp DOT       &mt RIGHT_SHIFT FSLH  &trans
&trans  &kp LCTRL         &kp LGUI    &kp LALT          &lt 6 INTERNATIONAL_5   &lt 4 SPACE             &lt 5 GRAVE  &lt 5 BACKSPACE  &lt 1 ENTER  &trans  &trans     &lt 2 ESCAPE  &kp RIGHT_CONTROL     &trans
            >;
        };

        Win_sign {
            bindings = <
&trans  &trans            &trans            &trans            &trans            &trans                  &trans  &trans                 &trans             &trans            &trans                   &trans
&trans  &kp LS(N9)        &trans            &trans            &trans            &trans                  &trans  &kp RIGHT_BRACKET      &kp BACKSLASH      &kp LEFT_BRACKET  &kp INTERNATIONAL_3      &trans
&trans  &kp LS(N5)        &kp LS(NUMBER_6)  &kp LS(N7)        &kp LS(N8)        &trans  &trans  &trans  &trans  &kp LS(N8)             &kp LS(N9)         &kp SEMICOLON     &kp SQT                  &trans
&trans  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &trans  &trans  &trans  &trans  &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)  &kp EQUAL         &kp RS(INTERNATIONAL_1)  &trans
&trans  &trans            &trans            &trans            &trans            &trans  &trans  &trans  &trans  &trans                 &trans             &trans            &trans                   &trans
            >;
        };

        pad_base {
            bindings = <
&trans  &trans            &trans      &trans            &trans                  &trans                                              &trans       &trans  &trans     &trans        &trans                &trans
&trans  &mt ESC Q         &mt C_PP W  &mt LA(C_MUTE) E  &mt C_VOL_DN R          &mt C_VOL_UP T                                      &kp Y        &kp U   &kp I      &kp O         &mt AT_SIGN P         &trans
&trans  &kp A             &kp S       &kp D             &mt C_BRIGHTNESS_DEC F  &mt C_BRIGHTNESS_INC G  &trans       &trans         &kp H        &kp J   &kp K      &kp L         &lt 5 MINUS           &trans
&trans  &mt LEFT_SHIFT Z  &kp X       &kp C             &kp V                   &kp B                   &kp TAB      &kp B          &kp N        &kp M   &kp COMMA  &kp DOT       &mt RIGHT_SHIFT FSLH  &trans
&trans  &kp LCTRL         &kp LGUI    &kp LALT          &lt 6 LC(SPACE)         &lt 4 SPACE             &lt 5 GLOBE  &kp BACKSPACE  &lt 3 ENTER  &trans  &trans     &lt 0 ESCAPE  &kp RIGHT_CONTROL     &trans
            >;
        };

        pad_sign {
            bindings = <
&trans  &trans                 &trans             &trans            &trans                &trans                  &trans  &trans                &trans                 &trans         &trans          &trans
&trans  &kp RIGHT_PARENTHESIS  &trans             &trans            &trans                &trans                  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp AT_SIGN    &kp BACKSLASH   &trans
&trans  &kp LS(N5)             &kp AMPERSAND      &kp SQT           &kp LEFT_PARENTHESIS  &trans  &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp COLON       &trans
&trans  &kp LS(NUMBER_1)       &kp DOUBLE_QUOTES  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)      &trans  &trans  &trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp CARET      &kp UNDERSCORE  &trans
&trans  &trans                 &trans             &trans            &trans                &trans  &trans  &trans  &trans  &trans                &trans                 &trans         &trans          &trans
            >;
        };

        Fc+Nm {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                  &trans           &trans  &trans  &trans     &trans                          &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans                  &kp KP_MULTIPLY  &kp N7  &kp N8  &kp N9     &mt MINUS LS(EQUAL)             &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans  &trans  &kp SLASH        &kp N4  &kp N5  &kp N6     &mt LS(SEMICOLON) SINGLE_QUOTE  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans  &trans  &kp DOT          &kp N1  &kp N2  &kp N3     &kp LS(MINUS)                   &trans
&trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &kp N0           &trans  &trans  &kp ENTER  &trans                          &trans
            >;
        };

        move {
            bindings = <
&trans  &trans             &trans                  &trans            &trans                   &trans                                 &trans     &trans           &trans       &trans         &trans         &trans
&trans  &kp LC(MINUS)      &kp LG(LC(LEFT_ARROW))  &kp LG(UP_ARROW)  &kp LC(LG(RIGHT_ARROW))  &kp LC(LG(F4))                         &kp HOME   &kp PAGE_UP      &kp UP       &kp PAGE_DOWN  &kp DELETE     &trans
&trans  &kp LC(SEMICOLON)  &kp LG(LEFT)            &kp LG(DOWN)      &kp LG(RIGHT)            &kp LC(LG(D))   &trans  &trans         &kp END    &kp LEFT         &kp DOWN     &kp RIGHT      &kp BACKSPACE  &trans
&trans  &trans             &kp LS(LC(TAB))         &trans            &kp LC(TAB)              &kp LG(TAB)     &trans  &kp LG(LS(S))  &kp LC(Z)  &kp LS(LC(TAB))  &kp LG(TAB)  &kp LC(TAB)    &kp ENTER      &trans
&trans  &trans             &trans                  &trans            &trans                   &trans          &trans  &trans         &trans     &trans           &trans       &trans         &trans         &trans
            >;
        };

        BT_set {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &BT0_layer0   &trans        &trans        &BT3_layer2   &BT4_layer2     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans     &trans       &trans     &trans         &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &mkp MB4   &kp PAGE_UP  &trans     &kp PAGE_DOWN  &kp LC(MINUS)   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &mkp MB5   &mkp MB1     &mkp MB3   &mkp MB2       &lt 5 LC(SEMI)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(A)  &kp LC(C)  &kp LC(T)    &kp LC(V)  &kp ENTER      &kp LC(W)       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans       &trans     &kp LS(LC(T))  &trans          &trans
            >;
        };
    };
};
