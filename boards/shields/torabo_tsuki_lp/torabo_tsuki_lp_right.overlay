#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* 1. ポインティングリスナーの設定 */
&pointing_listener {
    input-processors = 
        /* XY反転設定 */
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        
        /* 
         * モジュール標準のプロセッサを使用。
         * 第一引数にレイヤー番号（8）を指定します。
         */
        <&zip_scroll_transform  8>,

        /* オートマウス(レイヤー7)設定 */
        <&zip_temp_layer 7 2000>;
};

/* 2. オートマウス設定（除外キー ＋ 誤爆フィルター） */
&zip_temp_layer {
    /* タイピングの微振動（ノイズ）を無視する最小移動距離を設定（単位: ドット） */
    /* 10〜20の間で調整してください。値を大きくするほど誤爆しにくくなります */
    min-distance = <15>;

    /* 特定のキーを押している間、または押した直後の誤爆を防ぐ除外設定 */
    excluded-positions = <
        18 19 20 21 22
        32 33 34 35 36
        45 46 47 48 49 50
        63
    >;
};

/* 3. 既存のレイアウト変換設定（維持） */
&size_s_transform { col-offset = <7>; };
&size_m_transform { col-offset = <7>; };
&size_l_transform { col-offset = <7>; };
