#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* 1. ポインティングリスナーの設定 */
&pointing_listener {
    input-processors = 
        /* XY反転設定 */
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        
        /* 
         * モジュール標準のプロセッサを使用。
         * 第一引数にレイヤー番号（8）を指定します。
         */
        <&zip_scroll_transform  8>,

        /* オートマウス(レイヤー7)設定 */
        <&zip_temp_layer 7 2000>;
};

/* 2. オートマウス除外キー設定とホールド時間の調整 */
&zip_temp_layer {
    /* 
     * 【タイピング残響対策】
     * 除外キーを離したあと、オートマウスのロックを解除するまでの猶予時間（ミリ秒）。
     * もしこの記述がエラーになる場合は、この行だけ削除してください。
     */
    layers-block-duration-ms = <300>;

    /* 
     * 【超重要】ここに登録されているキーを叩いている間は、オートマウスが起動しません。
     * 現在、主に右手のキー（18〜22など）しか登録されていない可能性があります。
     * 左手側の文字キーや、ご自身がタイピング時に強く叩くキーのインデックス（番号）を
     * ここにすべて列挙して追加してください。
     */
    excluded-positions = <
        18 19 20 21 22
        32 33 34 35 36
        45 46 47 48 49 50
        63
        /* 例：左手側の主要な文字キーのインデックスもここに書き足す */
    >;
};

/* 3. 既存のレイアウト変換設定（維持） */
&size_s_transform { col-offset = <7>; };
&size_m_transform { col-offset = <7>; };
&size_l_transform { col-offset = <7>; };
