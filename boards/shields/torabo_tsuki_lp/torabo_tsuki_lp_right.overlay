#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* 1. ポインティングリスナーの設定（誤爆防止をここに統合） */
&pointing_listener {
    /* 
     * 【タイピング誤爆対策の核心】
     * どのキーでも、叩いたあとここで指定したミリ秒間（500ms = 0.5秒）は、
     * トラックボールの動きによるオートマウス（レイヤー7への遷移）を完全にロックします。
     * 本家 input-listener 由来のプロパティなので、ここで確実に機能します。
     */
    layers-block-duration-ms = <500>;

    input-processors = 
        /* XY反転設定 */
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        
        /* 
         * モジュール標準のプロセッサを使用。
         * 第一引数にレイヤー番号（8）を指定します。
         */
        <&zip_scroll_transform  8>,

        /* オートマウス(レイヤー7)設定 */
        <&zip_temp_layer 7 2000>;
};

/* 2. オートマウス除外キー設定（エラー行を削除して安全に維持） */
&zip_temp_layer {
    excluded-positions = <
        18 19 20 21 22
        32 33 34 35 36
        45 46 47 48 49 50
        63
    >;
};

/* 3. 既存のレイアウト変換設定（維持） */
&size_s_transform { col-offset = <7>; };
&size_m_transform { col-offset = <7>; };
&size_l_transform { col-offset = <7>; };
