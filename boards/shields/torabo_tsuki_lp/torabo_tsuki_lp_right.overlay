#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* 1. ポインティングリスナーの設定 */
&pointing_listener {
    input-processors = 
        /* XY反転設定 */
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        
        /* 
         * 【重要】自作の ib_scroll_report をここで呼び出します。
         * これにより「レイヤー6の時だけ」という条件分岐が確実に機能します。
         */
        <&ib_scroll_report 6 0>,

        /* オートマウス(レイヤー5)設定 */
        <&zip_temp_layer 5 2000>;
};

/* 2. オートマウス除外キー設定 */
&zip_temp_layer {
    excluded-positions = <
        19 21 33 34 35
        18 19 20 21 22
        32 33 34 35 36
        45 46 47 48 49 50
    >;
};

/* 3. 既存のレイアウト変換設定（維持） */
&size_s_transform { col-offset = <7>; };
&size_m_transform { col-offset = <7>; };
&size_l_transform { col-offset = <7>; };
