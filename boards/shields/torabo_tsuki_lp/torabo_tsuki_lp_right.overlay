#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* 1. ポインティングリスナーの設定 */
&pointing_listener {
    input-processors = 
        /* XY反転設定 */
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        
        /* スクロール変換レイヤー（レイヤー8） */
        <&zip_scroll_transform 8>;

    /* 
     * 拡張モジュールの zip_temp_layer によるオートマウスはエラーと誤爆の元なので
     * ここからは削除し、下の本家リスナーに処理を委ねます。
     */
};

/* 2. 本家標準の機能を使った、鉄壁の誤爆防止オートマウス定義 */
/ {
    /* 
     * 新しく「誤爆ブロック機能付き」のオートマウス・リスナーを生やします。
     * お使いのセンサー（pointing_device）の入力を直接監視します。
     */
    automouse_listener {
        compatible = "zmk,input-listener";
        device = <&pointing_device>;

        /* 【目的】レイヤー7（オートマウス先）へ自動遷移させる */
        execute-automouse;
        layer = <7>;

        /* 
         * 【タイピング誤爆対策の核心】
         * キーボードのキーをどれか一つでも叩いたあと、
         * ここで指定したミリ秒間（500ms = 0.5秒）は、
         * トラックボールがどれだけ振動しても「絶対に」レイヤー7に切り替わりません。
         */
        layers-block-duration-ms = <500>; 
    };
};

/* 3. 既存のレイアウト変換設定（維持） */
&size_s_transform { col-offset = <7>; };
&size_m_transform { col-offset = <7>; };
&size_l_transform { col-offset = <7>; };
